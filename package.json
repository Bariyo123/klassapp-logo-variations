{
  "name": "@caffeine/template-app",
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=7.0.0",
    "npm": "please use pnpm"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  },
  "pnpm": {
    "overrides": {
      "seroval": "1.5.6",
      "js-cookie": "3.0.8",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "postcss": "8.5.23",
      "rollup": "4.62.2",
      "@babel/core": "7.29.7",
      "anymatch>picomatch": "2.3.2",
      "readdirp>picomatch": "2.3.2",
      "micromatch>picomatch": "2.3.2",
      "tinyglobby>picomatch": "4.0.5",
      "sucrase>glob": "10.5.0",
      "glob>minimatch": "9.0.7",
      "minimatch>brace-expansion": "2.1.3"
    }
  }
}
